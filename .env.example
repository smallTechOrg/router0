# router0 configuration. Copy to .env and fill in. Never commit .env.

# PostgreSQL (the only external service). Bare-local: Homebrew postgresql@14, `make db`.
# Replace <you> with your OS user (`whoami`). Use 127.0.0.1, not localhost (IPv6 is refused).
DATABASE_URL=postgres://<you>@127.0.0.1:5432/router0?sslmode=disable

# HTTP server
PORT=8080

# Security
AES_KEY=                          # 64 hex chars (32 bytes): openssl rand -hex 32
JWT_SECRET=                       # min 32 bytes: openssl rand -base64 32

# Platform admin bootstrap (created, with its own org, on first start)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=                   # set before first run

# Optional: provider base URLs. Defaults are the real APIs; point at `make mock`
# to run without real keys.
# GROQ_BASE_URL=http://127.0.0.1:9901/v1
# OPENROUTER_BASE_URL=http://127.0.0.1:9902/v1
# ANTHROPIC_BASE_URL=http://127.0.0.1:9903/v1      # default https://api.anthropic.com/v1
# GOOGLE_BASE_URL=http://127.0.0.1:9904            # default https://generativelanguage.googleapis.com
# MESHAPI_BASE_URL=http://127.0.0.1:9905/v1        # default https://api.meshapi.ai/v1
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# TOGETHER_BASE_URL=https://api.together.xyz/v1
# BASETEN_BASE_URL=https://model.baseten.co

# Optional gateway tunables (defaults shown)
# ROUTER0_MAX_ATTEMPTS=8
# ROUTER0_ATTEMPT_TIMEOUT_SECONDS=120
# ROUTER0_STREAM_FIRST_BYTE_TIMEOUT_SECONDS=20
# ROUTER0_DEFAULT_RATE_LIMIT_COOLDOWN_SECONDS=30
# ROUTER0_CREDITS_COOLDOWN_SECONDS=3600
# ROUTER0_TRANSIENT_COOLDOWN_SECONDS=10
# ROUTER0_CATALOG_REFRESH_HOURS=6
# ROUTER0_TOKEN_CACHE_TTL_SECONDS=30
# ROUTER0_KEYSTATE_CACHE_MS=2000

# Optional real-key smoke tests (`make smoke`); each test skips when its key is empty
TEST_GROQ_KEY=
TEST_OPENROUTER_KEY=
TEST_ANTHROPIC_KEY=
TEST_GEMINI_KEY=
TEST_MESHAPI_KEY=                 # rsk_...

# Observability
LOG_LEVEL=info                    # debug | info | warn | error

# Go module mode (required if GO111MODULE is set globally to off)
GO111MODULE=on
