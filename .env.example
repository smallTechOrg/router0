# PostgreSQL connection
DATABASE_URL=postgres://zer0:zer0dev@127.0.0.1:5433/zer0router?sslmode=disable

# Redis connection
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# HTTP server
PORT=8080

# Security
AES_KEY=                          # 64 hex chars (32 bytes) — generate with: openssl rand -hex 32
JWT_SECRET=                       # min 32 bytes — generate with: openssl rand -base64 32

# Admin bootstrap
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=                   # Set before first run

# Testing — fill with real keys for integration tests
TEST_GROQ_KEY=                    # Real Groq API key (gsk_...)

# Optional: provider API base URLs (defaults shown)
GROQ_BASE_URL=https://api.groq.com/openai/v1
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
TOGETHER_BASE_URL=https://api.together.xyz/v1
BASETEN_BASE_URL=https://model.baseten.co

# Routing
ROUTING_STRATEGY=weighted         # or: bandit (Phase 2)
ACTIVE_POOL_FRACTION=0.80
PROBE_INTERVAL_SECONDS=300        # 5 min idle-key probe interval

# Observability
LOG_LEVEL=info                    # debug | info | warn | error
LOG_FORMAT=json                   # json | text (for local dev)

# Go module mode (required if GO111MODULE is set globally to off)
GO111MODULE=on
